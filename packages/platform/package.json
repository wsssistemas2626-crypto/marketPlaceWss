{
  "name": "@mkt/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@mkt/config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10",
    "@types/pg": "^8.15.6",
    "@testcontainers/postgresql": "^11.7.1",
    "@testcontainers/redis": "^11.7.1"
  },
  "dependencies": {
    "@mkt/shared-kernel": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "pg": "^8.16.3",
    "drizzle-orm": "^0.45.2",
    "@mkt/contracts": "workspace:*",
    "bullmq": "^5.65.0",
    "ioredis": "^5.9.0"
  }
