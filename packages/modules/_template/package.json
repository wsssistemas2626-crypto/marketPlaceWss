{
  "name": "@mkt/modules-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mkt/platform": "workspace:*",
    "@mkt/shared-kernel": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.1.13",
    "@mkt/contracts": "workspace:*",
    "@mkt/modules-identity": "workspace:*",
    "@mkt/modules-tenancy": "workspace:*"
  },
  "devDependencies": {
    "@mkt/config": "workspace:*",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
