# Copie para .env e preencha. Use SOMENTE a instância de DESENVOLVIMENTO do Clerk aqui.

# Banco local (docker compose)
DATABASE_URL_APP=postgres://app_user:app_user@localhost:5432/erp
DATABASE_URL_OWNER=postgres://app_owner:app_owner@localhost:5432/erp

# Clerk — aplicação app_3JdisYmzXgGLw4l1bhicBekMrMX
# Dashboard > Configure > API keys (instância de desenvolvimento)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Usuário de teste do E2E (criado no Clerk de desenvolvimento, membro de uma organização de teste)
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=troque-esta-senha

# API
API_PORT=3000
