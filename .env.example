# ============================================================
# Copie para .env e preencha. NUNCA faça commit do arquivo .env
# ============================================================

# --- Banco e infraestrutura local (docker-compose) ---
# Roles criadas por infra/db/local-init.sh (mesmas da Railway — ADR-014)
POSTGRES_USER=postgres                 # superusuário do container: SÓ para bootstrap, nunca para a aplicação
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace
DB_MIGRATOR_PASSWORD=migrator
DB_APP_PASSWORD=app
DB_PLATFORM_PASSWORD=platform
DATABASE_URL=postgres://app:app@localhost:5432/marketplace                    # runtime (sujeito a RLS)
DATABASE_URL_MIGRATOR=postgres://migrator:migrator@localhost:5432/marketplace # migrações
DATABASE_URL_PLATFORM=postgres://platform:platform@localhost:5432/marketplace # outbox relay / @PlatformJob (worker)
REDIS_URL=redis://localhost:6379
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-master-key
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=marketplace
SMTP_URL=smtp://localhost:1025        # Mailpit (UI em http://localhost:8025)

# --- Domínio da plataforma ---
PLATFORM_ROOT_DOMAIN=localhost        # produção: ex. suaplataforma.com.br
STOREFRONT_URL_TEMPLATE=http://{slug}.localhost:3000

# --- Clerk: aplicação "Plataforma" (admin do tenant + seller center) — ADR-013 ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"   # verificação sem chamada de rede
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
CLERK_AUTHORIZED_PARTIES=http://localhost:3001,http://localhost:3002

# --- Clerk: aplicação "Console" (staff da plataforma) ---
CONSOLE_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_yyy
CONSOLE_CLERK_SECRET_KEY=sk_test_yyy
CONSOLE_CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
CONSOLE_CLERK_WEBHOOK_SIGNING_SECRET=whsec_yyy

# --- Identidade própria dos compradores (storefront) ---
CUSTOMER_JWT_PRIVATE_KEY=              # gerado na US-011
CUSTOMER_JWT_PUBLIC_KEY=

# --- Domínios de tenants (Cloudflare for SaaS → Railway) — US-085 ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
EDGE_SHARED_SECRET=dev-edge-secret     # o storefront só confia em X-Forwarded-Host com este segredo

# --- Railway (apenas referência; na nuvem as variáveis vêm do painel da Railway) ---
# Ver docs/arquitetura/07-infraestrutura-railway.md §4 para as variáveis de referência de cada serviço.

# --- Criptografia de credenciais de integrações por tenant ---
INTEGRATIONS_ENCRYPTION_KEY=           # 32 bytes base64 (dev); produção via KMS
